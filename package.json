{
	"name": "@utilities-studio/infra",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "bun --no-env-file run --workspaces --if-present build",
		"typecheck": "tsc --noEmit",
		"test": "bun --no-env-file test",
		"check": "bun --no-env-file run typecheck && bun --no-env-file run build && bun --no-env-file run test",
		"changeset": "changeset",
		"release:version": "changeset version && bun --no-env-file install --lockfile-only --ignore-scripts",
		"release:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.2",
		"@types/bun": "1.4.2",
		"typescript": "7.0.2"
	}
}
