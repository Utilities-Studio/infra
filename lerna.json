{
	"version": "independent",
	"npmClient": "bun",
	"npmClientArgs": ["--no-env-file"],
	"command": {
		"version": {
			"allowBranch": "main",
			"conventionalCommits": true,
			"changelogPreset": "conventionalcommits",
			"syncWorkspaceLock": true,
			"message": "chore(release): version packages [skip ci]",
			"ignoreChanges": ["**/*.md", "**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/__fixtures__/**"]
		}
	}
}
