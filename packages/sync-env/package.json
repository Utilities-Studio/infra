{
	"name": "@utilities-studio/sync-env",
	"version": "1.1.6",
	"description": "Sync environment variables to Cloudflare Workers and Supabase Edge Functions",
	"repository": {
		"type": "git",
		"url": "https://github.com/Utilities-Studio/infra",
		"directory": "packages/sync-env"
	},
	"bin": {
		"sync-env": "src/index.ts"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"exports": {
		"./secret-keys": {
			"types": "./dist/secret-keys.d.ts",
			"import": "./dist/secret-keys.js",
			"require": "./dist/secret-keys.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown src/secret-keys.ts --format esm --format cjs --dts --out-dir dist --clean --no-fixed-extension"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.0",
		"cac": "^7.0.0",
		"dotenv": "^17.4.2",
		"jsonc-parser": "^3.3.1",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2"
	}
}
