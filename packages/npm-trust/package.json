{
	"name": "@utilities-studio/npm-trust",
	"version": "1.0.0",
	"description": "Configure npm trusted publishing for every publishable package in a repository",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Utilities-Studio/infra",
		"directory": "packages/npm-trust"
	},
	"bin": {
		"npm-trust": "src/index.ts"
	},
	"files": [
		"src/index.ts",
		"src/npm-client.ts",
		"src/trust.ts"
	],
	"scripts": {
		"check": "bun --no-env-file run lint && bun --no-env-file run test",
		"test": "bun --no-env-file test",
		"lint": "oxlint --type-aware --type-check src"
	},
	"dependencies": {
		"@manypkg/get-packages": "3.1.0",
		"cac": "7.0.0",
		"compare-versions": "6.1.1",
		"picocolors": "1.1.1",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@types/bun": "1.4.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
